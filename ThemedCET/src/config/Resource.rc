#include "Windows.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,0,0,0
    PRODUCTVERSION 1,0,0,0
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS 0x40004L
    FILETYPE 0x2L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",        "Cyber Engine Tweaks Team"
            VALUE "FileDescription",    "Cyber Engine Tweaks"
            VALUE "FileVersion",        "1.0.0"
            VALUE "LegalCopyright",     "© 2020-2026 Cyber Engine Tweaks Team. All Rights Reserved"
            VALUE "OriginalFilename",   "cyber_engine_tweaks.asi"
            VALUE "ProductName",        "Cyber Engine Tweaks"
            VALUE "ProductVersion",     "1.0.0 [main]"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
	    VALUE "Translation", 0x0409 0x04E2
    END
END
